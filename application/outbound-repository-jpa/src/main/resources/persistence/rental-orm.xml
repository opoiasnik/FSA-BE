<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence/orm
        https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
        version="3.0">

    <!-- User Entity -->
    <entity class="sk.fsa.rental.domain.User" access="FIELD">
        <table name="users"/>
        <attributes>
            <id name="id">
                <column name="user_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="keycloakId">
                <column name="keycloak_id" unique="true"/>
            </basic>
            <basic name="name">
                <column name="name" nullable="false"/>
            </basic>
            <basic name="surname">
                <column name="surname"/>
            </basic>
            <basic name="email">
                <column name="email" nullable="false" unique="true"/>
            </basic>
            <basic name="createdAt">
                <column name="created_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="phone">
                <column name="phone_number"/>
            </basic>
            <basic name="bio">
                <column name="bio" length="1000"/>
            </basic>
            <basic name="emailVerified">
                <column name="email_verified" nullable="false"/>
            </basic>
            <basic name="emailVerificationCode">
                <column name="email_verification_code"/>
            </basic>
            <basic name="emailVerificationExpiresAt">
                <column name="email_verification_expires_at"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="messageEmailNotifications">
                <column name="message_email_notifications" nullable="false"/>
            </basic>
            <basic name="viewingEmailNotifications">
                <column name="viewing_email_notifications" nullable="false"/>
            </basic>
            <basic name="viewingRequestEmailNotifications">
                <column name="viewing_request_email_notifications" nullable="false"/>
            </basic>
            <basic name="role">
                <column name="role" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <many-to-one name="avatarPhoto" target-entity="sk.fsa.rental.domain.Photo">
                <join-column name="avatar_photo_id" nullable="true"/>
            </many-to-one>
            <one-to-many name="ownedListings" target-entity="sk.fsa.rental.domain.Listing" mapped-by="owner"/>
            <one-to-many name="favorites" target-entity="sk.fsa.rental.domain.Favorite" mapped-by="user">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <!-- Listing Entity -->
    <entity class="sk.fsa.rental.domain.Listing" access="FIELD">
        <table name="listing"/>
        <attributes>
            <id name="id">
                <column name="listing_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="title">
                <column name="title" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" nullable="false" length="2000"/>
            </basic>
            <basic name="listingType">
                <column name="listing_type" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="status">
                <column name="status" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="createdAt">
                <column name="created_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <many-to-one name="owner" target-entity="sk.fsa.rental.domain.User">
                <join-column name="owner_id" nullable="false"/>
            </many-to-one>
            <one-to-many name="photos" target-entity="sk.fsa.rental.domain.Photo" mapped-by="listing" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
            <embedded name="address">
                <attribute-override name="street">
                    <column name="address_street" nullable="false"/>
                </attribute-override>
                <attribute-override name="city">
                    <column name="address_city" nullable="false"/>
                </attribute-override>
                <attribute-override name="postalCode">
                    <column name="address_postal_code" nullable="false"/>
                </attribute-override>
                <attribute-override name="country">
                    <column name="address_country" nullable="false"/>
                </attribute-override>
                <attribute-override name="district">
                    <column name="address_district"/>
                </attribute-override>
                <attribute-override name="region">
                    <column name="address_region"/>
                </attribute-override>
                <attribute-override name="lat">
                    <column name="address_lat"/>
                </attribute-override>
                <attribute-override name="lng">
                    <column name="address_lng"/>
                </attribute-override>
            </embedded>
            <embedded name="price">
                <attribute-override name="amount">
                    <column name="price_amount" nullable="false" precision="10" scale="2"/>
                </attribute-override>
                <attribute-override name="currency">
                    <column name="price_currency" nullable="false"/>
                </attribute-override>
            </embedded>
            <embedded name="features">
                <attribute-override name="propertyType">
                    <column name="property_type" nullable="false"/>
                </attribute-override>
                <attribute-override name="area">
                    <column name="features_area"/>
                </attribute-override>
                <attribute-override name="roomCount">
                    <column name="features_room_count"/>
                </attribute-override>
                <attribute-override name="floor">
                    <column name="features_floor"/>
                </attribute-override>
                <attribute-override name="furnished">
                    <column name="features_furnished"/>
                </attribute-override>
                <attribute-override name="parkingAvailable">
                    <column name="features_parking_available"/>
                </attribute-override>
                <attribute-override name="balcony">
                    <column name="features_balcony"/>
                </attribute-override>
                <attribute-override name="elevator">
                    <column name="features_elevator"/>
                </attribute-override>
                <attribute-override name="petsAllowed">
                    <column name="features_pets_allowed"/>
                </attribute-override>
                <attribute-override name="energyClass">
                    <column name="features_energy_class"/>
                </attribute-override>
                <attribute-override name="yearBuilt">
                    <column name="features_year_built"/>
                </attribute-override>
            </embedded>
        </attributes>
    </entity>

    <!-- Photo Entity -->
    <entity class="sk.fsa.rental.domain.Photo" access="FIELD">
        <table name="photo"/>
        <attributes>
            <id name="id">
                <column name="photo_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="altText">
                <column name="alt_text"/>
            </basic>
            <basic name="contentType">
                <column name="content_type"/>
            </basic>
            <basic name="originalFilename">
                <column name="original_filename"/>
            </basic>
            <basic name="position">
                <column name="position"/>
            </basic>
            <basic name="data">
                <column name="data"/>
            </basic>
            <many-to-one name="listing" target-entity="sk.fsa.rental.domain.Listing">
                <join-column name="listing_id" nullable="true"/>
            </many-to-one>
        </attributes>
    </entity>

    <!-- Favorite Entity -->
    <entity class="sk.fsa.rental.domain.Favorite" access="FIELD">
        <table name="favorite"/>
        <attributes>
            <id name="id">
                <column name="favorite_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="createdAt">
                <column name="created_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <many-to-one name="user" target-entity="sk.fsa.rental.domain.User">
                <join-column name="user_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="listing" target-entity="sk.fsa.rental.domain.Listing">
                <join-column name="listing_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

    <!-- ViewingRequest Entity -->
    <entity class="sk.fsa.rental.domain.ViewingRequest" access="FIELD">
        <table name="viewing_request"/>
        <attributes>
            <id name="id">
                <column name="viewing_request_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="requestedDate">
                <column name="requested_date" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="status">
                <column name="status" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="note">
                <column name="note"/>
            </basic>
            <many-to-one name="requester" target-entity="sk.fsa.rental.domain.User">
                <join-column name="requester_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="owner" target-entity="sk.fsa.rental.domain.User">
                <join-column name="owner_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="listing" target-entity="sk.fsa.rental.domain.Listing">
                <join-column name="listing_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

    <!-- Conversation Entity -->
    <entity class="sk.fsa.rental.domain.Conversation" access="FIELD">
        <table name="conversation">
            <unique-constraint name="uq_conversation_listing_owner_requester">
                <column-name>listing_id</column-name>
                <column-name>owner_id</column-name>
                <column-name>requester_id</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <id name="id">
                <column name="conversation_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="createdAt">
                <column name="created_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="updatedAt">
                <column name="updated_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <many-to-one name="listing" target-entity="sk.fsa.rental.domain.Listing">
                <join-column name="listing_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="owner" target-entity="sk.fsa.rental.domain.User">
                <join-column name="owner_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="requester" target-entity="sk.fsa.rental.domain.User">
                <join-column name="requester_id" nullable="false"/>
            </many-to-one>
            <one-to-many name="messages" target-entity="sk.fsa.rental.domain.Message" mapped-by="conversation">
                <order-by>sentAt ASC</order-by>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <!-- Message Entity -->
    <entity class="sk.fsa.rental.domain.Message" access="FIELD">
        <table name="message"/>
        <attributes>
            <id name="id">
                <column name="message_id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="text">
                <column name="text" nullable="false" length="2000"/>
            </basic>
            <basic name="sentAt">
                <column name="sent_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="readAt">
                <column name="read_at"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <many-to-one name="conversation" target-entity="sk.fsa.rental.domain.Conversation">
                <join-column name="conversation_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="sender" target-entity="sk.fsa.rental.domain.User">
                <join-column name="sender_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

    <!-- ListingViewEvent Entity -->
    <entity class="sk.fsa.rental.domain.ListingViewEvent" access="FIELD">
        <table name="listing_view_event"/>
        <attributes>
            <id name="id">
                <column name="id"/>
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="listingId">
                <column name="listing_id" nullable="false"/>
            </basic>
            <basic name="ownerId">
                <column name="owner_id" nullable="false"/>
            </basic>
            <basic name="viewedAt">
                <column name="viewed_at" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
        </attributes>
    </entity>

    <!-- Address Embeddable -->
    <embeddable class="sk.fsa.rental.domain.Address" access="FIELD">
        <attributes>
            <basic name="street"/>
            <basic name="city"/>
            <basic name="postalCode"/>
            <basic name="country"/>
            <basic name="district"/>
            <basic name="region"/>
            <basic name="lat"/>
            <basic name="lng"/>
        </attributes>
    </embeddable>

    <!-- Price Embeddable -->
    <embeddable class="sk.fsa.rental.domain.Price" access="FIELD">
        <attributes>
            <basic name="amount"/>
            <basic name="currency"/>
        </attributes>
    </embeddable>

    <!-- PropertyFeatures Embeddable -->
    <embeddable class="sk.fsa.rental.domain.PropertyFeatures" access="FIELD">
        <attributes>
            <basic name="propertyType">
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="area"/>
            <basic name="roomCount"/>
            <basic name="floor"/>
            <basic name="furnished"/>
            <basic name="parkingAvailable"/>
            <basic name="balcony"/>
            <basic name="elevator"/>
            <basic name="petsAllowed"/>
            <basic name="energyClass"/>
            <basic name="yearBuilt"/>
        </attributes>
    </embeddable>

</entity-mappings>
