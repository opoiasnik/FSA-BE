<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="14-create-listing-view-event" author="opoiasnik">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="listing_view_event"/></not>
        </preConditions>
        <createTable tableName="listing_view_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="listing_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_view_event_listing" references="listing(listing_id)"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_view_event_owner" references="users(user_id)"/>
            </column>
            <column name="viewed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="listing_view_event" indexName="idx_view_event_owner_viewed_at">
            <column name="owner_id"/>
            <column name="viewed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
