@startuml
title Property Rental Backend - Viewing Request Flow

skinparam shadowing false
autonumber

actor "User" as user
participant "Angular Frontend" as fe
participant "ViewingRequestRestController" as controller
participant "CurrentUserDetailService" as currentUser
participant "ViewingRequestMapper" as mapper
participant "ViewingRequestFacade\n(ViewingRequestService)" as service
participant "ListingRepository Port" as listingPort
participant "ViewingRequestRepository Port" as viewingPort
participant "JPA Adapters" as jpa
participant "NotificationEmailFacade" as notifications
database "PostgreSQL" as db

user -> fe : Submit viewing date and note
fe -> controller : POST /api/viewings
controller -> currentUser : resolve authenticated user
currentUser --> controller : User
controller -> mapper : map DTO to domain
mapper --> controller : ViewingRequest
controller -> service : createRequest(request, listingId, user)
service -> listingPort : findById(listingId)
listingPort -> jpa
jpa -> db
db --> jpa
jpa --> listingPort : Listing
listingPort --> service : Listing
service -> service : assign requester, owner, listing
service -> service : validate required fields,\nactive listing,\nnot own listing
service -> viewingPort : save(viewingRequest)
viewingPort -> jpa
jpa -> db
db --> jpa
jpa --> viewingPort : saved request
viewingPort --> service : saved request
service -> notifications : viewingRequestCreated(saved request)
notifications --> service
service --> controller : saved request
controller -> mapper : map domain to response DTO
mapper --> controller : response DTO
controller --> fe : 200 OK
fe --> user : Show toast confirmation

@enduml
